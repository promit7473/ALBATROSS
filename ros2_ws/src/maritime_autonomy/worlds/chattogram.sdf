<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="chattogram_sim">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <update_rate>30</update_rate>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>



    <scene>
      <ambient>0.4 0.4 0.4</ambient>
      <background>0.7 0.8 0.9</background>
    </scene>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry>
          <material>
            <ambient>0.15 0.35 0.15</ambient>
            <diffuse>0.2 0.5 0.2</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="ocean">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry>
          <material>
            <ambient>0.05 0.15 0.35 0.6</ambient>
            <diffuse>0.1 0.25 0.5 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://drone</uri>
      <pose>0 0 2 0 0 0</pose>
    </include>
  </world>
</sdf>
