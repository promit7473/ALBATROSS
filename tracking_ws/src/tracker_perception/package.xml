<?xml version="1.0"?>
<package format="3">
  <name>tracker_perception</name>
  <version>0.1.0</version>
  <description>YOLO detection, multi-object tracking (ByteTrack-style) and target lock with re-identification.</description>
  <maintainer email="merajhossainpromit@gmail.com">Meraj Hossain Promit</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tracker_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
